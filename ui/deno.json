{
  "nodeModulesDir": "auto",
  "exclude": [
    "dist",
    "node_modules",
    ".vite"
  ],
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "check": "deno fmt && deno lint && deno check src/ vite.config.ts"
  },
  "imports": {
    "@hono/zod-validator": "npm:@hono/zod-validator@^0.9.0",
    "@radix-ui/react-dialog": "npm:@radix-ui/react-dialog@^1.1.23",
    "@radix-ui/react-dropdown-menu": "npm:@radix-ui/react-dropdown-menu@^2.1.24",
    "@std/async": "jsr:@std/async@^1.5.0",
    "@std/csv": "jsr:@std/csv@^1.0.6",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/log": "jsr:@std/log@^0.224.14",
    "@std/path": "jsr:@std/path@^1.1.2",
    "@std/streams": "jsr:@std/streams@^1.1.2",
    "@tanstack/react-form": "npm:@tanstack/react-form@^1.33.5",
    "@tanstack/react-pacer": "npm:@tanstack/react-pacer@^0.23.0",
    "@tanstack/react-query": "npm:@tanstack/react-query@^5.102.1",
    "@tanstack/react-router": "npm:@tanstack/react-router@^1.170.32",
    "@tanstack/react-store": "npm:@tanstack/react-store@^0.11.1",
    "@tanstack/react-table": "npm:@tanstack/react-table@^9.1.2",
    "@tanstack/react-virtual": "npm:@tanstack/react-virtual@^3.14.10",
    "@types/react": "npm:@types/react@^19.1.0",
    "@types/react-dom": "npm:@types/react-dom@^19.1.0",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^5.0.0",
    "@zip-js/zip-js": "jsr:@zip-js/zip-js@^2.8.57",
    "date-fns": "npm:date-fns@^4.4.0",
    "date-fns/locale": "npm:date-fns@^4.4.0/locale",
    "decimal.js": "npm:decimal.js@^10.6.0",
    "echarts": "npm:echarts@^6.0.0",
    "hono": "npm:hono@^4.13.3",
    "lucide-react": "npm:lucide-react@^0.545.0",
    "react": "npm:react@^19.1.0",
    "react-dom": "npm:react-dom@^19.1.0",
    "react-dom/client": "npm:react-dom@^19.1.0/client",
    "react-error-boundary": "npm:react-error-boundary@^6.1.3",
    "react/jsx-runtime": "npm:react@^19.1.0/jsx-runtime",
    "vite": "npm:vite@^7.1.0",
    "zod": "npm:zod@^4.4.3"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true
  },
  "fmt": {
    "lineWidth": 110
  }
}
